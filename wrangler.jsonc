{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muthashiamma-kshetram",
  "main": "app.py",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muthashiamma-db",
      "database_id": "1c2354a3-ed51-43c8-b97d-cd5e6f97ce37" 
    }
  ]
}
